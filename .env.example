# Database connection (Supabase / PostgreSQL)
# Transaction pooler URL (for Prisma Client queries)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aloshop?schema=public"
# Direct connection URL (for migrations and Prisma CLI)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aloshop?schema=public"

# Initial / Environment SuperAdmin credentials
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="your_secure_password_here"

# Authentication secret for JWT / session tokens
AUTH_SECRET="change-this-to-a-secure-random-32-char-secret"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Filiallar (Branches)
model Branch {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  city         String            @default("Toshkent")
  address      String
  phone        String
  workingHours String
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  inventory    BranchInventory[]
  users        User[]
  orders       Order[]           @relation("PickupBranch")
}

// Admin foydalanuvchilar rollari
enum UserRole {
  SUPER_ADMIN
  BRANCH_ADMIN
}

// Foydalanuvchilar (Admins & Branch Managers)
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(BRANCH_ADMIN)
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([branchId])
}

// Mahsulot kategoriyalari
model Category {
  id        String    @id @default(cuid())
  nameUz    String
  nameRu    String
  nameEn    String
  slug      String    @unique
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]
}

// Telefon/Mahsulot umumiy modeli
model Product {
  id             String           @id @default(cuid())
  brand          String           // Apple, Samsung, Xiaomi
  modelName      String           // iPhone 15 Pro, Galaxy S24 Ultra
  slug           String           @unique
  descriptionUz  String           @db.Text
  descriptionRu  String           @db.Text
  descriptionEn  String           @db.Text
  warrantyMonths Int              @default(12)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  variants       ProductVariant[]

  @@index([categoryId])
}

// Aniq konfiguratsiya (Rang, Xotira, Narx)
model ProductVariant {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String            @unique
  colorNameUz String
  colorNameRu String
  colorNameEn String
  colorHex    String            // Hex kod: masalan, #9A958E
  storage     String            // 128GB, 256GB, 512GB, 1TB
  condition   String            @default("NEW") // NEW, USED (B/U)
  price       Decimal           @db.Decimal(12, 2) // So'mda
  oldPrice    Decimal?          @db.Decimal(12, 2)
  images      String[]          // Rasm URL manzillari
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  inventory   BranchInventory[]
  orderItems  OrderItem[]
  imeiRecords IMEIRecord[]

  @@index([productId])
}

// Filiallar bo'yicha tovar qoldig'i (Multi-branch inventory)
model BranchInventory {
  id        String         @id @default(cuid())
  branchId  String
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([branchId, variantId])
  @@index([branchId])
  @@index([variantId])
}

// Kelajakdagi POS va kafolat uchun IMEI zaxirasi
model IMEIRecord {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imeiNumber String         @unique
  status     String         @default("IN_STOCK") // IN_STOCK, SOLD
  createdAt  DateTime       @default(now())

  @@index([variantId])
}

// Buyurtmani qabul qilish usullari
enum OrderFulfillment {
  PICKUP_FROM_BRANCH
  DELIVERY
}

// Buyurtma holatlari
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

// To'lov usullari
enum PaymentType {
  CASH_ON_DELIVERY
  PAY_AT_BRANCH
  CARD_ON_DELIVERY
}

// Buyurtmalar (Orders)
model Order {
  id              String           @id @default(cuid())
  orderNumber     String           @unique
  customerName    String
  customerPhone   String
  fulfillmentType OrderFulfillment
  pickupBranchId  String?
  pickupBranch    Branch?          @relation("PickupBranch", fields: [pickupBranchId], references: [id], onDelete: SetNull)
  deliveryAddress String?
  notes           String?
  totalAmount     Decimal          @db.Decimal(12, 2)
  status          OrderStatus      @default(PENDING)
  paymentType     PaymentType      @default(CASH_ON_DELIVERY)
  isPaid          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           OrderItem[]

  @@index([pickupBranchId])
}

// Buyurtma ichidagi mahsulotlar
model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal        @db.Decimal(12, 2)

  @@index([orderId])
  @@index([variantId])
}
